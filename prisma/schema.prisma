datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String                  @id @default(uuid())
  email                 String                  @unique
  username              String                  @unique
  passwordHash          String
  avatarUrl             String?
  role                  String                  @default("user") // "admin" | "user"
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  lastLoginAt           DateTime?
  scans                 Scan[]
  serverTargets         ServerTarget[]
  authorizedIntegrations AuthorizedIntegration[]
  auditLogs             AuditLog[]
}

model ServerTarget {
  id                    String                  @id @default(uuid())
  ownerId               String?
  owner                 User?                   @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  displayName           String
  targetType            String                  // "ip_port" | "server_id"
  normalizedIdentifier  String                  @unique // e.g. "123.45.67.89:30120" or "cfx:k8x9pq"
  ip                    String?
  port                  Int?
  serverCode            String?
  lastOnlineStatus      Boolean                 @default(false)
  lastPlayers           Int                     @default(0)
  lastMaxPlayers        Int                     @default(0)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  scans                 Scan[]
  authorizedIntegrations AuthorizedIntegration[]
}

model Scan {
  id              String       @id @default(uuid())
  userId          String?
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  targetId        String
  target          ServerTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  status          String       // "queued" | "validating" | "connecting" | "fetching_metadata" | "analyzing" | "generating_report" | "completed" | "partial" | "failed" | "cancelled"
  scanMode        String       @default("public") // "public" | "authorized"
  startedAt       DateTime     @default(now())
  finishedAt      DateTime?
  errorCode       String?
  errorMessage    String?
  scannerVersion  String       @default("1.0.0")
  rawData         String?      // Stored JSON
  summaryJson     String?      // High level summary JSON
  results         ScanResult[]
  evidences       Evidence[]

  @@index([targetId])
  @@index([status])
}

model ScanResult {
  id                 String       @id @default(uuid())
  scanId             String
  scan               Scan         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  resultType         String       // "framework" | "resource" | "game_system"
  resourceCatalogId  String?
  catalogItem        ResourceCatalog? @relation(fields: [resourceCatalogId], references: [id], onDelete: SetNull)
  name               String
  version            String?
  category           String?
  verificationStatus String       // "confirmed" | "strong_evidence" | "weak_evidence" | "unverified" | "not_detected"
  confidenceScore    Int          @default(0) // 0 - 100
  summary            String?
  createdAt          DateTime     @default(now())
  evidences          Evidence[]

  @@index([scanId])
}

model Evidence {
  id                 String       @id @default(uuid())
  scanId             String
  scan               Scan         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  resultId           String?
  scanResult         ScanResult?  @relation(fields: [resultId], references: [id], onDelete: Cascade)
  sourceType         String       // "info_json" | "dynamic_json" | "players_json" | "cfx_api" | "authorized_agent" | "public_docs"
  sourceReference    String?      // URL or endpoint
  evidenceType       String       // "meta_tag" | "resource_entry" | "server_var" | "manifest_signature"
  description        String
  rawValue           String?      // Sanitized value
  integrityHash      String?
  verificationStatus String       @default("confirmed")
  observedAt         DateTime     @default(now())

  @@index([scanId])
  @@index([resultId])
}

model ResourceCatalog {
  id                  String          @id @default(uuid())
  slug                String          @unique
  name                String
  category            String          // "core" | "inventory" | "interaction" | "police_ems" | "vehicles" | "economy" | "phone" | "housing" | "clothing" | "hud" | "anticheat" | "admin" | "other"
  description         String
  author              String?
  officialUrl         String?
  documentationUrl    String?
  supportedFrameworks String?         // Comma-separated or JSON
  detectionNotes      String?
  verifiedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  rules               DetectionRule[]
  scanResults         ScanResult[]
}

model DetectionRule {
  id                String          @id @default(uuid())
  resourceId        String
  resource          ResourceCatalog @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  ruleType          String          // "resource_name" | "server_var" | "banner_tag" | "manifest_entry"
  ruleConfiguration String          // JSON config with pattern, matcher, score
  enabled           Boolean         @default(true)
  version           Int             @default(1)
  updatedAt         DateTime        @updatedAt

  @@index([resourceId])
}

model AuthorizedIntegration {
  id            String       @id @default(uuid())
  ownerId       String
  owner         User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  targetId      String
  target        ServerTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  tokenHash     String       @unique
  status        String       @default("active") // "active" | "revoked"
  allowedFields String?      // JSON array of strings e.g. ["resources", "manifests", "tags"]
  createdAt     DateTime     @default(now())
  lastSeenAt    DateTime?
  revokedAt     DateTime?

  @@index([ownerId])
  @@index([targetId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String   // e.g. "USER_REGISTER", "SCAN_CREATED", "SETTINGS_UPDATED", "INTEGRATION_CREATED"
  entityType String   // "User" | "Scan" | "ServerTarget" | "AuthorizedIntegration"
  entityId   String?
  metadata   String?  // JSON text
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
}
